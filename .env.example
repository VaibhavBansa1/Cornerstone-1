# Copy this file to ".env" (same folder) and fill in what you have.
# .env is ignored by git, so your keys are never uploaded.

# Which AI to use, in order; the next one answers if one fails.
LLM_PROVIDERS=openrouter,groq,ollama

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

GROQ_API_KEY=

# Change before any demo on a shared network.
ADMIN_PASSWORD=mits-admin
